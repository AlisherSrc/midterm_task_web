# =====================================================================
# Space Bounty Hunters API Configuration
# =====================================================================

# Server Port
APP_PORT=8000
APP_HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# For Docker Compose, host is 'db'
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=space_bounty_hunters

# Optional Direct SQLAlchemy Connection URL:
# If set, overrides the individual DB_* settings above.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/space_bounty_hunters
